# file names under /assets/ contain a content hash, so they never change
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# files served straight from static assets (the worker sets these itself on pages)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), browsing-topics=()
