{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "notsobot-com-web",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // hashed bundles and the favicon skip the worker (and its request billing) entirely
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg"]
  },
  // every subdomain of notsobot.com, like nsb.gg: notsobot.com and www. are the site, anything else 404s (SITE_HOSTS in the
  // worker). beta.notsobot.com's own route below is more specific, so it stays on the beta script, and notsobot.com/api/*
  // has a "no worker" route on the zone (see the readme)
  "routes": [
    {"pattern": "*notsobot.com/*", "zone_name": "notsobot.com"},
    // notso.bot and www. redirect to notsobot.com with the path kept (REDIRECT_DOMAINS in the worker), any other
    // subdomain 404s too. production only
    {"pattern": "*notso.bot/*", "zone_name": "notso.bot"}
  ],
  "vars": {
    "SITE_DOMAIN": "notsobot.com",
    // only production is indexed, beta gets noindex on every page and a robots.txt that disallows everything
    "ALLOW_INDEXING": "true"
    // UMAMI_WEBSITE_ID is a secret from .dev.vars (.dev.vars.beta for beta), uploaded by `npm run deploy` (see the readme)
  },
  "env": {
    "beta": {
      "routes": [
        {"pattern": "beta.notsobot.com/*", "zone_name": "notsobot.com"}
      ],
      "vars": {
        "SITE_DOMAIN": "beta.notsobot.com",
        "ALLOW_INDEXING": "false"
      }
    }
  }
}
